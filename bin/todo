#!/usr/bin/env bash
#
# todo - central, data-oriented dev-idea capture.
#
#   Capture is instant and dumb (append raw text, no model, no network).
#   Classification is deferred and batched via a headless `claude -p` call,
#   so its reasoning never enters the session you captured from.
#
# See README.md for the data model and design.
set -euo pipefail

TODO_DIR="${TODO_DIR:-/srv/dev/repos/todo}"
TODO_MODEL="${TODO_MODEL:-haiku}"
TODO_FALLBACK_MODEL="${TODO_FALLBACK_MODEL:-}"   # empty = none; if set, use a Sonnet-4-or-lower id, NOT the `sonnet` alias
TODO_REPOLIST="${TODO_REPOLIST:-/srv/dev/repos/my-system/users/dev/sections/repo-descriptions.md}"

INBOX="$TODO_DIR/inbox.jsonl"
TODOS="$TODO_DIR/todos.jsonl"
SEQ="$TODO_DIR/.seq"
LOCK="$TODO_DIR/.lock"
LOGDIR="$TODO_DIR/logs"
PROMPT="$TODO_DIR/classify/system-prompt.md"

# Group that must retain write access to the store. Derived from the (setgid)
# store dir so ethan's `todo-capture` (member of that group, but not the file
# owner) can always append to the shared inbox. See fix_perms.
STORE_GROUP=$(stat -c %G "$TODO_DIR" 2>/dev/null || echo developers)

die() { printf 'todo: %s\n' "$*" >&2; exit 1; }

command -v jq  >/dev/null 2>&1 || die "jq not found on PATH"

now() { date -Iseconds; }

# Ensure store files exist (a fresh clone or a bad TODO_DIR shouldn't crash add).
ensure_store() {
    [ -d "$TODO_DIR" ] || die "TODO_DIR does not exist: $TODO_DIR"
    touch "$INBOX" "$TODOS"
    fix_perms
}

# Keep the store group-owned + group-writable. Store rewrites go through
# mktemp+mv (classify/mutate/rm). Historically mktemp put the temp in /tmp as
# 0600 dev:dev and the mv made the store inherit that private mode — silently
# locking ethan's group-`developers` todo-capture out of the inbox (the root
# cause of a bumped .seq with no saved record). Rewrites now go through
# store_mv, which asserts the shared group+mode BEFORE the swap so the store is
# never even transiently private; fix_perms remains a backstop, re-asserting
# group+mode after every touch. Best-effort: read paths and non-owners skip.
fix_perms() {
    chgrp "$STORE_GROUP" "$INBOX" "$TODOS" 2>/dev/null || true
    chmod 0664 "$INBOX" "$TODOS" 2>/dev/null || true
}

# Create a rewrite temp INSIDE the setgid store dir, so it inherits the store's
# group (`developers`) instead of the caller's private primary group. Callers
# write their new content into this path, then hand it to store_mv.
mk_store_tmp() { mktemp "$TODO_DIR/.store.XXXXXX"; }

# Atomically replace a store file with a freshly-written temp, asserting the
# shared group+0664 mode BEFORE the mv. This closes the window an interrupted
# rewrite used to leave behind: a store file stranded 0600 dev:dev, unreadable
# to ethan's group-`developers` reader/capture. Best-effort perms (|| true) so
# non-owner rewrites still complete; pair with mk_store_tmp.
store_mv() {
    local tmp="$1" dest="$2"
    chgrp "$STORE_GROUP" "$tmp" 2>/dev/null || true
    chmod 0664 "$tmp" 2>/dev/null || true
    mv "$tmp" "$dest"
}

count() { jq -s 'length' "$1"; }

# Next monotonic, never-reused id as a bare number. Seeded from the max of the
# tracked counter (.seq) and the current file ids, so a removed id is never
# handed out again. Pure: it does NOT persist .seq — the caller advances the
# counter only after the record is safely written (see cmd_add), so a failed
# append can't burn an id and lose the capture. Call only while holding the lock.
next_id() {
    local filemax seqval
    filemax=$(cat "$INBOX" "$TODOS" 2>/dev/null \
        | jq -rs 'map(.id | ltrimstr("t-") | tonumber) | (max // 0)')
    seqval=$(cat "$SEQ" 2>/dev/null || echo 0)
    printf '%s' "$(( (filemax > seqval ? filemax : seqval) + 1 ))"
}

# Commit the store if anything changed. Local only; never pushes, never needs auth.
commit() {
    fix_perms
    git -C "$TODO_DIR" add -A 2>/dev/null || return 0
    git -C "$TODO_DIR" diff --cached --quiet 2>/dev/null && return 0
    git -C "$TODO_DIR" commit -q -m "$1" 2>/dev/null || true
}

# Find a record by id in todos then inbox; prints the JSON object or nothing.
find_record() {
    jq -c --arg id "$1" 'select(.id==$id)' "$TODOS" "$INBOX" 2>/dev/null | head -n1
}

# ---------------------------------------------------------------------------

cmd_add() {
    [ "$#" -gt 0 ] || die "usage: todo add <text…>"
    ensure_store
    local text="$*" n id created rec
    (
        flock 9
        n=$(next_id)
        id=$(printf 't-%04d' "$n")
        created=$(now)
        rec=$(jq -cn --arg id "$id" --arg created "$created" --arg text "$text" \
            '{id:$id, created:$created, text:$text, status:"raw"}')
        printf '%s\n' "$rec" >> "$INBOX"   # record lands first — never lose it
        printf '%s' "$n" > "$SEQ"          # advance the counter only after the append succeeds
        commit "add $id"
        printf '✓ todo %s captured\n' "$id"
    ) 9>"$LOCK"
}

cmd_classify() {
    # Dev-only: classify runs `claude -p` and reads the dev-repo prompt/repo-list,
    # so it is genuine dev code. Every other command operates on the group-writable
    # shared store and is safe for ethan (see install.sh's ethan deploy).
    [ "$(id -un)" = dev ] || die "classify is dev-only (runs claude + dev-repo code); ask dev to classify"
    ensure_store
    command -v claude >/dev/null 2>&1 || die "claude CLI not found on PATH"

    # Snapshot the inbox under lock, then release it so `add` never blocks on the
    # (slow) model call.
    local snapshot
    snapshot=$(mktemp)
    ( flock 9; cp "$INBOX" "$snapshot"; ) 9>"$LOCK"

    local n
    n=$(count "$snapshot")
    if [ "$n" -eq 0 ]; then rm -f "$snapshot"; echo "nothing to classify"; return 0; fi

    local items repolist payload sysprompt
    items=$(jq -sc '[.[] | {id, text}]' "$snapshot")
    repolist=$(cat "$TODO_REPOLIST" 2>/dev/null || echo "(repo list unavailable)")
    payload=$(printf 'Repos:\n\n%s\n\nTodos (classify each):\n%s\n' "$repolist" "$items")
    sysprompt=$(cat "$PROMPT")

    local raw result clean fb=()
    [ -n "$TODO_FALLBACK_MODEL" ] && fb=(--fallback-model "$TODO_FALLBACK_MODEL")

    raw=$(claude -p \
        --model "$TODO_MODEL" \
        "${fb[@]}" \
        --output-format json \
        --disallowed-tools Bash Edit Write Read Glob Grep WebFetch WebSearch Task \
        --append-system-prompt "$sysprompt" \
        "$payload" 2>&1) || { log_fail "$snapshot" "$payload" "$raw"; die "classifier call failed (see logs/)"; }

    result=$(jq -r '.result // empty' <<<"$raw" 2>/dev/null || true)
    # Strip a leading/trailing ``` fence if the model added one.
    clean=$(printf '%s' "$result" | sed -e '1{/^```/d}' -e '${/^```/d}')

    if ! jq -e 'type=="array"' >/dev/null 2>&1 <<<"$clean"; then
        log_fail "$snapshot" "$payload" "$raw"
        die "classifier returned unparseable output (items left in inbox; see logs/)"
    fi

    # Merge enrichment onto the raw records, applying defaults for anything the
    # model omitted or left unsure.
    local merged
    merged=$(jq -s --slurpfile e <(printf '%s' "$clean") '
        ($e[0]) as $enr
        | [ .[] as $r
            | ([ $enr[] | select(.id == $r.id) ][0]) as $x
            | { id: $r.id, created: $r.created, text: $r.text,
                title:    ($x.title // $r.text),
                repo:     ($x.repo // null),
                type:     ($x.type // "idea"),
                tags:     ($x.tags // []),
                priority: ($x.priority // null),
                dupe_of:  ($x.dupe_of // null),
                status: "open", done: null } ]' "$snapshot")

    local ids
    ids=$(jq -c '[.[].id]' <<<"$items")

    (
        flock 9
        jq -c '.[]' <<<"$merged" >> "$TODOS"
        local tmp; tmp=$(mk_store_tmp)
        jq -c --argjson ids "$ids" 'select([.id] | inside($ids) | not)' "$INBOX" > "$tmp" 2>/dev/null || : > "$tmp"
        store_mv "$tmp" "$INBOX"
        commit "classify $n"
    ) 9>"$LOCK"

    log_ok "$payload" "$raw"
    rm -f "$snapshot"
    echo "classified $n"
}

log_ok()   { mkdir -p "$LOGDIR"; jq -n --arg in "$1" --arg out "$2" --arg ts "$(now)" \
                '{ts:$ts, ok:true, input:$in, output:$out}' > "$LOGDIR/classify-$(date +%Y%m%d-%H%M%S).json"; }
log_fail() { mkdir -p "$LOGDIR"; jq -n --arg in "$2" --arg out "$3" --arg ts "$(now)" \
                '{ts:$ts, ok:false, input:$in, output:$out}' > "$LOGDIR/classify-$(date +%Y%m%d-%H%M%S)-FAIL.json"; }

cmd_list() {
    ensure_store
    local repo="" type="" scope="open"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --repo) repo="$2"; shift 2;;
            --type) type="$2"; shift 2;;
            --all)  scope="all"; shift;;
            --done) scope="done"; shift;;
            *) die "unknown flag: $1";;
        esac
    done

    # Instant and read-only: never classifies, never touches the model. Reads
    # classified todos AND raw inbox captures, normalizing both to one shape so
    # freshly-added items show up immediately (with placeholders for the fields
    # classification would fill in). Run `todo classify` to enrich them.
    { printf 'ID\tREPO\tTYPE\tTAGS\tTITLE\n'
      jq -r --arg repo "$repo" --arg type "$type" --arg scope "$scope" '
        ( if .status == "raw" then
            { id, repo: "-", type: "raw", tags: "-", title: .text, status: "raw" }
          else
            { id,
              repo:  (.repo // "-"),
              type:  .type,
              tags:  ((.tags // []) | join(",") | if . == "" then "-" else . end),
              title: .title,
              status: .status }
          end ) as $n
        | select(
            ($scope == "all")
            or ($scope == "open" and ($n.status == "open" or $n.status == "raw"))
            or ($scope == $n.status)
          )
        | select( ($repo == "") or ($n.repo == $repo) )
        | select( ($type == "") or ($n.type == $type) )
        | [ $n.id, $n.repo, $n.type, $n.tags, $n.title ] | @tsv' "$TODOS" "$INBOX"
    } | column -t -s $'\t'
}

cmd_show() {
    [ "$#" -eq 1 ] || die "usage: todo show <id>"
    local r; r=$(find_record "$1")
    [ -n "$r" ] || die "no such todo: $1"
    jq . <<<"$r"
}

# Rewrite todos.jsonl through a jq program, under lock, then commit.
mutate_todos() {
    local prog="$1" msg="$2" tmp
    (
        flock 9
        tmp=$(mk_store_tmp)
        jq -c "$prog" "$TODOS" > "$tmp"
        store_mv "$tmp" "$TODOS"
        commit "$msg"
    ) 9>"$LOCK"
}

cmd_done() {
    [ "$#" -eq 1 ] || die "usage: todo done <id>"
    ensure_store
    local id="$1"
    if ! jq -e --arg id "$id" 'select(.id==$id)' "$TODOS" >/dev/null 2>&1; then
        # Not classified yet? Drain the inbox, then it will be in todos. Only dev
        # can classify (it's dev code); a non-dev caller gets an honest error
        # instead of a silent no-op from mutate_todos not finding the raw id.
        if jq -e --arg id "$id" 'select(.id==$id)' "$INBOX" >/dev/null 2>&1; then
            if [ "$(id -un)" = dev ]; then
                ( cmd_classify ) >/dev/null 2>&1 || true
            else
                die "$id is unclassified; ask dev to run 'todo classify' first"
            fi
        else
            die "no such todo: $id"
        fi
    fi
    mutate_todos "if .id==\"$id\" then .status=\"done\" | .done=\"$(now)\" else . end" "done $id"
    echo "done $id"
}

cmd_reopen() {
    [ "$#" -eq 1 ] || die "usage: todo reopen <id>"
    ensure_store
    mutate_todos "if .id==\"$1\" then .status=\"open\" | .done=null else . end" "reopen $1"
    echo "reopened $1"
}

cmd_rm() {
    [ "$#" -eq 1 ] || die "usage: todo rm <id>"
    ensure_store
    local id="$1"
    (
        flock 9
        local t
        for f in "$TODOS" "$INBOX"; do
            t=$(mk_store_tmp)
            jq -c --arg id "$id" 'select(.id != $id)' "$f" > "$t" 2>/dev/null || : > "$t"
            store_mv "$t" "$f"
        done
        commit "rm $id"
    ) 9>"$LOCK"
    echo "removed $id"
}

usage() {
    cat <<'EOF'
usage: todo <command> [args]

  add <text…>                          capture a raw todo (instant, no model)
  classify                             drain the inbox through the classifier (dev only)
  list [--repo X|--type T|--all|--done]  list todos (instant; includes unclassified)
  show <id>                            print a record
  done <id> | reopen <id> | rm <id>    lifecycle
EOF
}

main() {
    local cmd="${1:-}"; shift || true
    case "$cmd" in
        add)      cmd_add "$@";;
        classify) cmd_classify "$@";;
        list|ls)  cmd_list "$@";;
        show)     cmd_show "$@";;
        done)     cmd_done "$@";;
        reopen)   cmd_reopen "$@";;
        rm)       cmd_rm "$@";;
        ""|-h|--help|help) usage;;
        *) die "unknown command: $cmd (try: todo help)";;
    esac
}

main "$@"
